<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:Width="520" d:Height="420"
        Width="520" Height="420"
        x:Class="PdfToolBoxMac.MainWindow"
        Title="PDF ToolBox"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25" RowDefinitions="Auto, *, Auto">
        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="PDF ToolBox" FontSize="26" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Ferramentas rápidas para gerenciar seus arquivos PDF" FontSize="13" Foreground="#A0A0A0"/>
        </StackPanel>

        <!-- Botões de Ações -->
        <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,20,0,0">
            <Button Content="🧩 Juntar PDFs" Margin="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="#007ACC" Foreground="White" FontSize="14" FontWeight="SemiBold"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="BtnJuntar_Click"/>
            
            <Button Content="✂️ Dividir PDF" Margin="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="#28A745" Foreground="White" FontSize="14" FontWeight="SemiBold"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="BtnDividir_Click"/>

            <Button Content="🗑️ Remover Página" Margin="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="#DC3545" Foreground="White" FontSize="14" FontWeight="SemiBold"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="BtnRemover_Click"/>

            <Button Content="📄 Comprimir / Info" Margin="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="#6F42C1" Foreground="White" FontSize="14" FontWeight="SemiBold"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="BtnInfo_Click"/>
        </UniformGrid>

        <!-- Barra de Status -->
        <TextBlock Name="TxtStatus" Grid.Row="2" Text="Pronto para uso" FontSize="12" Foreground="#888888" HorizontalAlignment="Center"/>
    </Grid>
</Window>